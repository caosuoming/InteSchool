# 对外监听端口
INTESCHOOL_PORT=3000

# 经 HTTPS 反向代理部署时必须设为 true
INTESCHOOL_COOKIE_SECURE=false

# 默认不信任 X-Forwarded-*。经反向代理部署时填写可信代理 IP/CIDR 或跳数。
# 示例：INTESCHOOL_TRUST_PROXY=172.18.0.0/16
INTESCHOOL_TRUST_PROXY=false

# 生产环境默认关闭演示账号。仅在受控测试环境启用，并设置强密码。
INTESCHOOL_ENABLE_DEMO=false
INTESCHOOL_SEED_DEMO_DATA=false
INTESCHOOL_DEMO_EMAIL=li.zhang@bj04.edu.cn
INTESCHOOL_DEMO_PASSWORD=

# 首次生产部署必须设置。管理员创建成功后可从 .env 中删除密码并重启。
INTESCHOOL_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
INTESCHOOL_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
INTESCHOOL_BOOTSTRAP_ADMIN_NAME=平台管理员
INTESCHOOL_BOOTSTRAP_SCHOOL_ID=sch-1
INTESCHOOL_BOOTSTRAP_SCHOOL_NAME=示例中学
INTESCHOOL_BOOTSTRAP_SCHOOL_CODE=EXAMPLE
INTESCHOOL_BOOTSTRAP_SCHOOL_CITY=南京

# 学校认证默认需要管理员审核
INTESCHOOL_AUTO_APPROVE_APPLICATIONS=false
INTESCHOOL_SESSION_DAYS=30
INTESCHOOL_MAX_UPLOAD_BYTES=52428800
# 文档拆解会排队执行，避免多个 DOCX/PDF 同时解析耗尽内存
INTESCHOOL_DOCUMENT_EXTRACTION_CONCURRENCY=3

# 可选：OpenAI-compatible 聊天补全接口，仅由服务端读取
INTESCHOOL_AI_BASE_URL=
INTESCHOOL_AI_API_KEY=
INTESCHOOL_AI_MODEL=
