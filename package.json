{
  "name": "inteschool",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "INTESCHOOL_SERVE_STATIC=false tsx watch server/index.ts",
    "build:web": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:server",
    "check:mathtype": "node scripts/check-mathtype-runtime.mjs",
    "prestart": "npm run check:mathtype",
    "start": "node build/server/server/index.js",
    "lint": "eslint .",
    "check": "tsc -b --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "npm run lint && npm run check && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/compress": "^9.1.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/katex": "^0.16.8",
    "@xmldom/xmldom": "^0.8.13",
    "better-sqlite3": "^13.0.1",
    "cfb": "^1.2.2",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "emf-converter": "^2.0.2",
    "fastify": "^5.10.0",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "katex": "^0.18.0",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.12.0",
    "mathjax": "^3.2.2",
    "mathjax-full": "^3.2.2",
    "mathml2omml": "^0.5.0",
    "pdf-parse": "^2.4.5",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^9.0.1",
    "react-router": "8.3.0",
    "read-excel-file": "^9.3.5",
    "remark-gfm": "^4.0.0",
    "sanitize-html": "2.17.5",
    "tailwind-merge": "^3.0.2",
    "write-excel-file": "^4.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.15.30",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.6",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "description": "可使用 Docker 部署的教师题库、讲义、试卷和教学资源管理服务",
  "engines": {
    "node": ">=22.22.0"
  }
}
