{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "build/server",
    "declaration": false,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["server/**/*.ts", "src/types/**/*.ts"],
  "exclude": ["node_modules", "dist", "build"]
}
